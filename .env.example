# Supabase project configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# Google Calendar OAuth
# Set GOOGLE_OAUTH_REDIRECT_URI to: https://<your-cloud-run-url>/auth/google/callback
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Optional 32-byte encryption key (URL-safe base64).
# When omitted, derived from SUPABASE_SERVICE_ROLE_KEY.
PLANNER_CREDENTIAL_ENCRYPTION_KEY=

# CORS origins (comma-separated) allowed to call the API
PLANNER_WEB_ORIGINS=http://localhost:3000

# Public URL of this API server (Cloud Run URL in production)
# Used by the /api/gpt/openapi.json schema endpoint
PLANNER_API_URL=http://localhost:8000

# MCP authentication (for Claude Desktop / MCP clients)
MCP_API_KEY=
MCP_USER_ID=
