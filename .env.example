# Supabase project configuration. Copy to .env.local and fill locally.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Calendar web OAuth. Keep the secret only in local/deployment environment variables.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
# Legacy local names GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are also accepted.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Optional separate 32-byte encryption key encoded with URL-safe base64.
# When omitted, Planner OS derives a stable development key from the service-role key.
PLANNER_CREDENTIAL_ENCRYPTION_KEY=
PLANNER_WEB_ORIGINS=http://localhost:3000
PLANNER_WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_PLANNER_API_URL=http://localhost:8000
