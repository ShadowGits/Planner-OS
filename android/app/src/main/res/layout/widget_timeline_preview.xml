   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Study German" android:textSize="15sp" android:textColor="#292325" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:text="45m · Scheduled" android:textSize="11sp" android:textColor="#766A6D" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>
 </LinearLayout>
 <FrameLayout android:layout_width="44dp" android:layout_height="52dp">
