<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="68dp" android:gravity="center_vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
 <LinearLayout android:id="@+id/widget_task_open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="center_vertical">
  <LinearLayout android:layout_width="62dp" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="6dp">
   <TextView android:id="@+id/widget_start" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="09:00" android:textSize="14sp" android:textStyle="bold" android:textColor="#292325"/>
   <TextView android:id="@+id/widget_end" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="09:45" android:textSize="12sp" android:textColor="#766A6D"/>
  </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="4dp">
   <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Study German" android:textSize="15sp" android:textColor="#292325" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
   <TextView android:id="@+id/widget_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:text="45 min · Scheduled" android:textSize="11sp" android:textColor="#766A6D" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>
 </LinearLayout>
 <FrameLayout android:id="@+id/widget_task_check" android:layout_width="44dp" android:layout_height="52dp">
  <TextView android:id="@+id/widget_check" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:background="@drawable/widget_check_empty" android:gravity="center" android:text="" android:textColor="#FFFFFF" android:textSize="15sp"/>
 </FrameLayout>
</LinearLayout>
