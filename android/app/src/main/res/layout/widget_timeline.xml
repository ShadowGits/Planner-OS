<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
  <LinearLayout android:id="@+id/widget_open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
   <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Today" android:textSize="18sp" android:textStyle="bold" android:textColor="#292325" android:maxLines="1" android:ellipsize="end"/>
   <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your timeline" android:textSize="12sp" android:textColor="#766A6D" android:maxLines="1"/>
  </LinearLayout>
  <TextClock android:id="@+id/widget_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:textSize="14sp" android:textColor="#A23B50" android:textStyle="bold" android:paddingEnd="8dp"/>
  <TextView android:id="@+id/widget_refresh" android:layout_width="44dp" android:layout_height="44dp" android:text="↻" android:gravity="center" android:textSize="26sp" android:textColor="#A23B50" android:contentDescription="Refresh saved timeline"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
  <TextView android:id="@+id/widget_previous" android:layout_width="44dp" android:layout_height="44dp" android:text="‹" android:gravity="center" android:textSize="26sp" android:textColor="#766A6D" android:contentDescription="Previous day"/>
  <TextView android:id="@+id/widget_today" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:text="Today" android:gravity="center" android:textSize="13sp" android:textStyle="bold" android:textColor="#A23B50" android:contentDescription="Return to today"/>
  <TextView android:id="@+id/widget_next" android:layout_width="44dp" android:layout_height="44dp" android:text="›" android:gravity="center" android:textSize="26sp" android:textColor="#766A6D" android:contentDescription="Next day"/>
 </LinearLayout>
 <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <ListView android:id="@+id/widget_tasks" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="#E9E2DE" android:dividerHeight="0.5dp" android:clipToPadding="false" android:scrollbars="none"/>
  <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="16dp" android:text="No scheduled tasks.
Tap to plan your day." android:textSize="15sp" android:textColor="#766A6D"/>
 </FrameLayout>
 <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="22dp" android:gravity="center_vertical" android:paddingTop="5dp" android:text="Saved timeline · refreshes quietly" android:textSize="11sp" android:textColor="#766A6D" android:maxLines="2" android:ellipsize="end"/>
</LinearLayout>
