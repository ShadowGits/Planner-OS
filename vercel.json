{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "config/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/auth/google/callback", "destination": "/api/index.py" },
    { "source": "/mcp", "destination": "/api/index.py" },
    { "source": "/mcp/:path*", "destination": "/api/index.py" },
    { "source": "/authorize", "destination": "/api/index.py" },
    { "source": "/token", "destination": "/api/index.py" },
    { "source": "/.well-known/oauth-protected-resource/mcp", "destination": "/api/index.py" },
    { "source": "/messages", "destination": "/api/index.py" },
    { "source": "/messages/:path*", "destination": "/api/index.py" }
  ]
}
